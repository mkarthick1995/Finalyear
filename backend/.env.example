# RenalCare AI Backend Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
DATABASE_URL=sqlite:///./renal_care.db
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ENVIRONMENT=development

# Model Paths
VISION_MODEL_PATH=./models/kidney_stone_cnn.pth
VISION_METRICS_PATH=./models/vision_metrics.json

# Image Upload Settings
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIRECTORY=./uploads

# API Settings
API_VERSION=2.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# LLM-powered Health Goals (NVIDIA NIM - build.nvidia.com)
# Set to true and provide a real NVIDIA_API_KEY to enable AI-generated goals.
# When false (or key missing/rate-limited), the app serves rule-based goals.
ENABLE_LLM_GOALS=false
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_GOALS_MODEL=
